# Backend API base URL
# Local dev:  http://localhost:5000/api
# Production: https://api.zelostech.site/api (or your deployed backend URL)
VITE_API_URL=http://localhost:5000/api

# Google Sign-In — Client ID lấy từ Google Cloud Console > APIs & Services >
# Credentials > OAuth Client ID (loại Web application). Đăng ký Authorized
# JavaScript origins cho cả localhost:5173 (dev) và domain production.
# Để trống thì nút "Đăng nhập bằng Google" tự ẩn, không lỗi gì.
VITE_GOOGLE_CLIENT_ID=
