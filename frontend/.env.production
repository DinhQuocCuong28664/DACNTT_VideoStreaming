# Loaded automatically by Vite when running `vite build` (production mode).
# Keeps production builds correct without anyone needing to remember to set
# VITE_API_URL by hand. Update this if the backend EC2 instance IP/domain
# changes (e.g. once a stable domain or Elastic IP is set up).
# 2026-08-13: chuyển sang domain HTTPS qua Cloudflare + Nginx reverse proxy
# (port 80 -> 5000 trên EC2), thay cho gọi thẳng IP:port HTTP trước đây —
# cần thiết vì frontend giờ chạy HTTPS (Cloudflare), gọi API HTTP thuần sẽ
# bị trình duyệt chặn do mixed content.
VITE_API_URL=https://api.zelostech.site/api

# Google Sign-In — PHẢI điền trước khi build production, nhớ đăng ký
# "https://zelostech.site" làm Authorized JavaScript origin trên Google Cloud
# Console (khác origin với localhost:5173 dùng ở .env cho local dev).
VITE_GOOGLE_CLIENT_ID=114993607166-icpnvg75bgq016v0lofg70lft7vommpl.apps.googleusercontent.com
