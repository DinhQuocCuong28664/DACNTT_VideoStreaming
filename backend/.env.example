PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vidshare
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Frontend URL — used to build links sent in emails (e.g. password reset)
FRONTEND_URL=http://localhost:5173

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_RAW_BUCKET_NAME=vidshare-raw-bucket
S3_PROCESSED_BUCKET_NAME=vidshare-processed-bucket
CLOUDFRONT_DOMAIN=your_cloudfront_domain.cloudfront.net

# Email (Gmail SMTP) — for password reset
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM=DACNTT Video Platform <your_email@gmail.com>
