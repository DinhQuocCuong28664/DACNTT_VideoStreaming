PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vidshare
# JWT_SECRET nên dài tối thiểu 32 ký tự (bắt buộc ở môi trường production)
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters
JWT_EXPIRE=7d

# Frontend URL — used to build links sent in emails (e.g. password reset)
FRONTEND_URL=http://localhost:5173

# Danh sách Origin được phép gọi API (phân tách bằng dấu phẩy).
# Bỏ trống để dùng giá trị mặc định trong src/server.js
CORS_ORIGINS=https://zelostech.site,https://www.zelostech.site,http://localhost:5173

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_RAW_BUCKET_NAME=vidshare-raw-bucket
S3_PROCESSED_BUCKET_NAME=vidshare-processed-bucket
# Bucket công khai (đang host frontend static site) — tái dùng cho ảnh đại
# diện vì đã có sẵn policy public GetObject, không cần bucket riêng.
S3_STATIC_BUCKET_NAME=your-frontend-static-bucket
CLOUDFRONT_DOMAIN=your_cloudfront_domain.cloudfront.net

# ── CloudFront Signed Cookies (bảo vệ video riêng tư) ──
# Bỏ trống cả ba biến dưới đây để tắt cơ chế ký (phù hợp khi phát triển cục bộ).
# CLOUDFRONT_KEY_PAIR_ID lấy từ output `signing_key_pair_id` của Terraform.
CLOUDFRONT_KEY_PAIR_ID=
# Khóa bí mật RSA dạng PEM. Trong môi trường production phải đọc từ AWS Secrets
# Manager, KHÔNG lưu trực tiếp vào tệp .env. Ký tự xuống dòng có thể viết dạng \n.
CLOUDFRONT_PRIVATE_KEY=
# Tên miền cha dùng chung giữa ứng dụng và CDN để trình duyệt gửi kèm cookie,
# ví dụ .zelostech.site — bắt buộc khi CDN nằm ở tên miền con khác.
COOKIE_DOMAIN=

# Google Sign-In — Client ID tạo tại Google Cloud Console > APIs & Services >
# Credentials > OAuth Client ID (loại Web application). Phải trùng với
# VITE_GOOGLE_CLIENT_ID bên frontend/.env.
GOOGLE_CLIENT_ID=

# Email (Gmail SMTP) — for password reset
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM=DACNTT Video Platform <your_email@gmail.com>
