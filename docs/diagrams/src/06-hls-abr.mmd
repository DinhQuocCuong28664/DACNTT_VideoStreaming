graph TB
    SRC["Uploaded source file<br/>any container, codec and resolution"]
    FF["FFmpeg, one encoding pass per rung"]

    R1["360p at 800 kbps<br/>360p/index.m3u8<br/>plus .ts segments"]
    R2["720p at 2800 kbps<br/>720p/index.m3u8<br/>plus .ts segments"]
    R3["1080p at 5000 kbps<br/>1080p/index.m3u8<br/>plus .ts segments"]

    M["master.m3u8<br/>lists each rendition with its declared bandwidth"]
    PL["Player (hls.js)<br/>measures throughput and switches rung<br/>at a segment boundary"]

    SRC --> FF
    FF -->|"rung 1"| R1
    FF -->|"rung 2"| R2
    FF -->|"rung 3"| R3
    R1 --> M
    R2 --> M
    R3 --> M
    M -->|"fetch master, then the chosen<br/>rendition playlist and its segments"| PL

    classDef source fill:#e8f4f8,stroke:#2c7a9e,color:#1a1a1a
    classDef rend fill:#fff4e6,stroke:#d98324,color:#1a1a1a
    classDef manifest fill:#eef7ee,stroke:#3d8b40,color:#1a1a1a
    classDef player fill:#fdecea,stroke:#c0392b,color:#1a1a1a
    class SRC,FF source
    class R1,R2,R3 rend
    class M manifest
    class PL player
