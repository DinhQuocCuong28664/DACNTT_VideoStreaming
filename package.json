{
  "name": "zelos-video-platform",
  "private": true,
  "description": "Video sharing platform with an event-driven, serverless-container HLS transcoding pipeline",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "transcoder",
    "functions",
    "api",
    "web"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.15.0",
    "typescript": "~5.6",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
