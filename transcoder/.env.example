# Transcoder Environment Variables
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/vidshare
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_RAW_BUCKET_NAME=vidshare-raw-bucket
S3_PROCESSED_BUCKET_NAME=vidshare-processed-bucket
CLOUDFRONT_DOMAIN=your_cloudfront_domain.cloudfront.net
SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789/vidshare-transcode-queue

# Dùng để dựng link xem video trong email thông báo "video sẵn sàng"
FRONTEND_URL=http://localhost:5173

# Email (Gmail SMTP) — thông báo video sẵn sàng/thất bại tới người upload
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM=DACNTT Video Platform <your_email@gmail.com>
